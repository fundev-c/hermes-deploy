diff --git a/tests/agent/test_pre_verify_platforms.py b/tests/agent/test_pre_verify_platforms.py
new file mode 100644
index 0000000000..0f5215b798
--- /dev/null
+++ b/tests/agent/test_pre_verify_platforms.py
@@ -0,0 +1,54 @@
+"""hermes-deploy patch 0005: ``agent.pre_verify_platforms`` runs pre_verify without host file edits.
+
+Email/cron work happens in a Docker sandbox, which never registers as a host file mutation, so a
+task verifier registered on pre_verify was never consulted. The hook also receives the messages."""
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from agent import turn_stop_gates as g
+from agent.verify_hooks import pre_verify_platforms
+
+
+def _agent(platform, edited=()):
+    return SimpleNamespace(platform=platform, session_id="s1", model="m",
+                           _turn_file_mutation_paths=set(edited), _resolved_is_coding=False)
+
+
+@pytest.fixture
+def hooks():
+    seen = {}
+
+    def fake_msg(**kw):
+        seen.update(kw)
+        return "verifier says: fix it"
+    with patch("hermes_cli.lifecycle.has_hook", side_effect=lambda n: n == "pre_verify"), \
+         patch("hermes_cli.plugins.get_pre_verify_continue_message", side_effect=fake_msg), \
+         patch("agent.verify_hooks.max_verify_nudges", return_value=3), \
+         patch("agent.verify_hooks.pre_verify_platforms", return_value=frozenset({"email", "cron"})):
+        yield seen
+
+
+def test_opted_in_platform_fires_without_edits_and_gets_messages(hooks):
+    msgs = [{"role": "user", "content": "do it"}]
+    assert g._pre_verify_nudge(_agent("email"), "answer", 0, msgs) == "verifier says: fix it"
+    assert hooks["messages"] == msgs and hooks["platform"] == "email"
+
+
+def test_other_platforms_still_need_an_edit(hooks):
+    assert g._pre_verify_nudge(_agent("telegram"), "answer", 0, []) is None
+    assert g._pre_verify_nudge(_agent("telegram", ["a.py"]), "answer", 0, []) == "verifier says: fix it"
+
+
+def test_attempt_cap_still_applies(hooks):
+    assert g._pre_verify_nudge(_agent("email"), "answer", 3, []) is None
+
+
+@pytest.mark.parametrize("cfg,want", [
+    ({}, frozenset()),
+    ({"agent": {"pre_verify_platforms": ["Email", " cron "]}}, frozenset({"email", "cron"})),
+    ({"agent": {"pre_verify_platforms": "email,cron"}}, frozenset({"email", "cron"})),
+])
+def test_config_parsing(cfg, want):
+    assert pre_verify_platforms(cfg) == want
