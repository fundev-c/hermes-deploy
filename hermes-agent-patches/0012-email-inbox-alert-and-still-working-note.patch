+++ b/tests/gateway/test_email_inbox_alert.py
@@ -0,0 +1,115 @@
+"""Inbox-down desktop alert (hermes-deploy patch 0012): one notification once the inbox has been
+unreachable for EMAIL_INBOX_ALERT_MINUTES (default 10) across reconnect attempts, one when it is back."""
+import pytest
+
+import plugins.platforms.email.adapter as mod
+from plugins.platforms.email.adapter import EmailAdapter
+
+
+@pytest.fixture
+def clock(monkeypatch):
+    now = {"t": 1_000_000.0}
+    monkeypatch.setattr(mod.time, "time", lambda: now["t"])
+    monkeypatch.setattr(mod, "_get_secret", lambda name, default="": default)
+    monkeypatch.setattr(EmailAdapter, "_inbox_down_since", {})
+    monkeypatch.setattr(EmailAdapter, "_inbox_alerted", set())
+    return now
+
+
+@pytest.fixture
+def alerts(monkeypatch):
+    sent = []
+    monkeypatch.setattr(mod, "_desktop_notify", lambda title, body: sent.append(title))
+    return sent
+
+
+def fresh() -> EmailAdapter:
+    """The reconnect watcher builds a new adapter per retry."""
+    a = object.__new__(EmailAdapter)
+    a._address = "bot@gmail.com"
+    return a
+
+
+def test_alerts_once_after_ten_minutes_across_fresh_adapters(clock, alerts):
+    for minute in (0, 0.5, 1.5, 3.5, 7.5):
+        clock["t"] = 1_000_000 + minute * 60
+        fresh()._inbox_failed()
+    assert alerts == []
+    for minute in (12.5, 17.5):
+        clock["t"] = 1_000_000 + minute * 60
+        fresh()._inbox_failed()
+    assert alerts == ["Hermes email is offline"]
+    clock["t"] += 60
+    fresh()._inbox_ok()
+    assert alerts == ["Hermes email is offline", "Hermes email is back"]
+
+
+def test_short_outage_is_silent(clock, alerts):
+    fresh()._inbox_failed()
+    clock["t"] += 240
+    fresh()._inbox_failed()
+    fresh()._inbox_ok()
+    assert alerts == [] and EmailAdapter._inbox_down_since == {}
+
+
+def test_failed_imap_probe_counts_as_down(clock, alerts, monkeypatch):
+    a = fresh()
+    a._imap_host, a._imap_port = "imap.gmail.com", 993
+    a._set_fatal_error = lambda *args, **kw: None
+    a._inbox = lambda: (_ for _ in ()).throw(OSError("Temporary failure in name resolution"))
+    assert a._probe_imap(is_reconnect=True) is False
+    assert "bot@gmail.com" in EmailAdapter._inbox_down_since
+
+
+# --- "still working" note --------------------------------------------------------------------------
+import asyncio  # noqa: E402
+from unittest.mock import AsyncMock, MagicMock  # noqa: E402
+
+
+def adapter(monkeypatch, ack_minutes: str):
+    secrets = {"EMAIL_ACK_AFTER_MINUTES": ack_minutes}
+    monkeypatch.setattr(mod, "_get_secret", lambda name, default="": secrets.get(name, default))
+    a = EmailAdapter.__new__(EmailAdapter)
+    a.__init__(MagicMock(extra={"address": "bot@gmail.com"}))
+    a._sender_accepted = lambda *args: True
+    a.handle_message = AsyncMock()
+    a._send_email = MagicMock(return_value="<id@x>")
+    return a
+
+
+def mail(a, mid, subject="Upper case"):
+    return a._dispatch_message({"sender_addr": "carol@corp.com", "sender_name": "Carol", "subject": subject,
+                                "body": "hi", "attachments": [], "message_id": mid, "in_reply_to": ""})
+
+
+def test_slow_task_gets_one_note_in_its_thread(monkeypatch):
+    a = adapter(monkeypatch, "1")
+    monkeypatch.setattr(mod, "_esecret_int", lambda name, default: 0.0005 if name == "EMAIL_ACK_AFTER_MINUTES" else default)
+
+    async def go():
+        await mail(a, "<1@x>")
+        await asyncio.sleep(0.1)
+    asyncio.run(go())
+    to, body, rid = a._send_email.call_args.args
+    assert a._send_email.call_count == 1 and rid == "<1@x>" and "still working" in body
+
+
+def test_reply_in_time_cancels_the_note(monkeypatch):
+    a = adapter(monkeypatch, "1")
+    monkeypatch.setattr(mod, "_esecret_int", lambda name, default: 0.001 if name == "EMAIL_ACK_AFTER_MINUTES" else default)
+
+    async def go():
+        await mail(a, "<1@x>")
+        await a.send("carol@corp.com", "Done.", reply_to="<1@x>")
+        await asyncio.sleep(0.15)
+    asyncio.run(go())
+    assert [c.args[1] for c in a._send_email.call_args_list] == ["Done."]
+
+
+def test_note_can_be_turned_off(monkeypatch):
+    a = adapter(monkeypatch, "0")
+
+    async def go():
+        await mail(a, "<1@x>")
+    asyncio.run(go())
+    assert a._ack_timers == {}
