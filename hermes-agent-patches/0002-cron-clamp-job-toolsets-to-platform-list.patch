--- /dev/null
+++ b/tests/cron/test_cron_job_toolsets_clamped.py
@@ -0,0 +1,28 @@
+"""hermes-deploy: a cron job's own ``enabled_toolsets`` may only narrow ``platform_toolsets.cron``.
+
+On 2026-09-30 an email-created job asked for ``["terminal"]`` and got it, although cron's platform
+list was ``[beardrive, cronjob, skills]``. The per-job list is model-settable via the cronjob tool."""
+from cron.scheduler import _resolve_cron_enabled_toolsets
+
+CFG = {"platform_toolsets": {"cron": ["skills", "todo"]}, "mcp_servers": {}}
+
+
+def test_job_cannot_widen_past_cron_platform_list():
+    result = _resolve_cron_enabled_toolsets({"id": "j1", "enabled_toolsets": ["terminal", "file", "skills"]}, CFG)
+    assert "terminal" not in result
+    assert "file" not in result
+    assert result == ["skills"]
+
+
+def test_job_asking_only_for_disallowed_toolsets_gets_the_platform_list():
+    result = _resolve_cron_enabled_toolsets({"id": "j2", "enabled_toolsets": ["terminal"]}, CFG)
+    assert set(result) == {"skills", "todo"}
+
+
+def test_job_may_narrow():
+    assert _resolve_cron_enabled_toolsets({"id": "j3", "enabled_toolsets": ["todo"]}, CFG) == ["todo"]
+
+
+def test_terminal_allowed_when_cron_platform_list_has_it():
+    cfg = {"platform_toolsets": {"cron": ["skills", "terminal"]}, "mcp_servers": {}}
+    assert "terminal" in _resolve_cron_enabled_toolsets({"enabled_toolsets": ["terminal"]}, cfg)
