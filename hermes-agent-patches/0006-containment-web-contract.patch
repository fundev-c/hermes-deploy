+def test_web_on_a_jailed_platform_is_cloud_search_plus_sandboxed_extract(deployed_config):
+    names = set().union(*(_catalog(deployed_config, p) for p in JAILED_PLATFORMS))
+    if not names & {"web_search", "web_extract"}:
+        pytest.skip("no web on email/cron: nothing to contain")
+    assert not {n for n in names if n.startswith("browser_")}, "browser tools on email/cron"
+    web = deployed_config.get("web") or {}
+    assert web.get("search_backend") == "firecrawl", "web_search must go to Firecrawl cloud only"
+    assert web.get("extract_backend") == "firecrawl-local", "web_extract must use the sandboxed self-host"
+    assert not web.get("backend"), "a shared web.backend would override the per-capability split"
+    env = (DEPLOYED_HOME / ".env").read_text() if (DEPLOYED_HOME / ".env").is_file() else ""
+    assert "FIRECRAWL_API_URL=" not in env, "FIRECRAWL_API_URL would reroute cloud search"
+    import importlib
+    import sys
+    sys.path.insert(0, str(Path(os.environ["HERMES_HOME"]) / "plugins"))
+    provider = importlib.import_module("firecrawl_local.provider")
+    for line in env.splitlines():
+        if line.startswith("FIRECRAWL_LOCAL_URL="):
+            os.environ["FIRECRAWL_LOCAL_URL"] = line.split("=", 1)[1].strip().strip("'\"")
+    provider.local_url()  # raises unless loopback
+    enabled = set((deployed_config.get("plugins") or {}).get("enabled") or [])
+    assert {"learning", "firecrawl_local"} <= enabled, f"plugins.enabled is {sorted(enabled)}"
+    guard = importlib.import_module("learning.learning")
+    blocked = guard.on_pre_tool_call(tool_name="web_search", args={"query": "mail boss@corp.example now"},
+                                     session_id="containment")
+    assert blocked and blocked["action"] == "block", "web exfiltration guard is not active"
