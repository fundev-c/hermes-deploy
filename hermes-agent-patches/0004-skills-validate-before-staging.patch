+"""hermes-deploy: skill writes are validated BEFORE staging.
+
+Staging first meant a skill whose description broke the 60-char budget sat in pending/ until
+`/skills approve` rejected it (2026-09-29 03a35120, 2026-09-30 06184f81) -- with the model gone and
+nobody left to fix the text. Now the model gets the rejection in-turn and can retry.
+"""
+import json
+import os
+import shutil
+import tempfile
+import unittest
+from unittest.mock import patch
+
+LONG = "Use when auditing a spreadsheet's data quality. Emit corrections as a separate sheet."  # 90
+SHORT = "Audit a spreadsheet and list corrections in a new sheet."  # 56
+
+
+def skill(name, desc):
+    return f"---\nname: {name}\ndescription: {desc}\n---\n# Body\nStep 1.\n"
+
+
+class _Gated:
+    allow = False
+    blocked = False
+    message = "staged for review"
+
+
+class TestPrestageValidation(unittest.TestCase):
+    def setUp(self):
+        self.home = tempfile.mkdtemp(prefix="skprestage_")
+        os.environ["HERMES_HOME"] = self.home
+        os.makedirs(os.path.join(self.home, "skills"), exist_ok=True)
+        import importlib
+
+        import tools.skill_manager_tool as smt
+        importlib.reload(smt)
+        self.smt = smt
+        self.staged = []
+
+    def tearDown(self):
+        shutil.rmtree(self.home, ignore_errors=True)
+
+    def _gated(self, **kw):
+        import tools.write_approval as wa
+
+        def fake_stage(area, payload, summary=None, origin=None):
+            self.staged.append(payload)
+            return {"id": f"p{len(self.staged)}"}
+        with patch.object(wa, "evaluate_gate", return_value=_Gated()), \
+             patch.object(wa, "stage_write", side_effect=fake_stage):
+            return json.loads(self.smt.skill_manage(**kw))
+
+    def test_flat_create_with_long_description_is_not_staged(self):
+        assert len(LONG) > 60
+        r = self._gated(action="create", name="data-quality-audit", content=skill("data-quality-audit", LONG))
+        self.assertFalse(r.get("success"), r)
+        self.assertIn("Not staged", r["error"])
+        self.assertIn("60-char", r["error"])
+        self.assertEqual(self.staged, [])
+
+    def test_flat_create_with_short_description_is_staged(self):
+        r = self._gated(action="create", name="data-quality-audit", content=skill("data-quality-audit", SHORT))
+        self.assertTrue(r.get("staged"), r)
+        self.assertEqual(len(self.staged), 1)
+
+    def test_batch_with_one_bad_op_stages_nothing_and_names_the_op(self):
+        r = self._gated(action="create", name="dqa", operations=[
+            {"action": "create", "name": "dqa", "content": skill("dqa", LONG)},
+            {"action": "write_file", "name": "dqa", "file_path": "references/a.md", "file_content": "a"},
+        ])
+        self.assertFalse(r.get("success"), r)
+        self.assertIn("operations[0]", r["error"])
+        self.assertEqual(self.staged, [])
+
+    def test_valid_batch_still_stages_and_replays(self):
+        r = self._gated(action="create", name="dqa", operations=[
+            {"action": "create", "name": "dqa", "content": skill("dqa", SHORT)},
+            {"action": "write_file", "name": "dqa", "file_path": "references/a.md", "file_content": "a"},
+        ])
+        self.assertTrue(r.get("staged"), r)
+        out = json.loads(self.smt.apply_skill_pending(self.staged[0]))
+        self.assertTrue(out["success"], out)
+
+    def test_bad_name_is_rejected_before_staging(self):
+        r = self._gated(action="create", name="../escape", content=skill("x", SHORT))
+        self.assertFalse(r.get("success"), r)
+        self.assertEqual(self.staged, [])
+
+
+if __name__ == "__main__":
+    unittest.main()
