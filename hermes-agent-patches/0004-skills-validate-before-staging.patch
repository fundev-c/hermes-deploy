+def _prestage_error(action: str, name: str, args: dict) -> Optional[str]:
+    """hermes-deploy: the apply-time checks that need no disk state, run BEFORE a write is staged.
+    Staging first meant a 90-char description sat in pending/ until /skills approve rejected it --
+    with the model long gone and nobody left to fix the text. Rejecting in-turn lets it retry."""
+    from tools.skill_manager_batch import _op_shape_error
+    if (err := _op_shape_error(action, args)) is not None:
+        return err
+    if action == "create":
+        return (_validate_name(name) or _validate_frontmatter(args.get("content") or "", new_skill=True)
+                or _validate_content_size(args.get("content") or ""))
+    if action == "edit":
+        return _validate_frontmatter(args.get("content") or "") or _validate_content_size(args.get("content") or "")
+    if action == "write_file" and args.get("file_content") is not None:
+        return _validate_content_size(args["file_content"], label=args.get("file_path") or "file")
+    return None
+
+
+def _not_staged(err: str, where: str = "") -> str:
+    return tool_error(f"Not staged{where}: {err} Nothing was saved; fix it and call skill_manage again.",
+                      success=False)
+
