+++ b/tests/gateway/test_email_reply_cc.py
@@ -0,0 +1,53 @@
+"""Reply Cc (hermes-deploy patch 0008): a reply goes to the sender and Cc's the inbound mail's other
+To/Cc recipients, but only those on EMAIL_ALLOWED_USERS or the receive-only EMAIL_CC_RECIPIENTS.
+Being Cc'd never lets someone instruct the agent; the sender allowlist is unchanged."""
+import plugins.platforms.email.adapter as mod
+from plugins.platforms.email.adapter import EmailAdapter
+
+SECRETS = {"EMAIL_ALLOWED_USERS": "alice@corp.com, Bob@corp.com",
+           "EMAIL_CC_RECIPIENTS": "carol@corp.com"}
+
+
+def make(monkeypatch) -> EmailAdapter:
+    monkeypatch.setattr(mod, "_get_secret", lambda name, default="": SECRETS.get(name, default))
+    a = object.__new__(EmailAdapter)
+    a._address, a._thread_context = "bot@gmail.com", {}
+    a._skip_attachments, a._authserv_id = False, None
+    return a
+
+
+RAW = (b"From: Alice <alice@corp.com>\r\n"
+       b"To: bot@gmail.com, Bob <bob@corp.com>\r\n"
+       b"Cc: carol@corp.com, stranger@evil.com, BOT@gmail.com\r\n"
+       b"Subject: Vacation rentals\r\nMessage-ID: <m1@corp.com>\r\n\r\nhi\r\n")
+
+
+def test_parse_collects_to_and_cc(monkeypatch):
+    msg = make(monkeypatch)._parse_fetched_message(b"1", RAW)
+    assert msg["other_recipients"] == ["bot@gmail.com", "bob@corp.com", "carol@corp.com",
+                                       "stranger@evil.com", "bot@gmail.com"]
+
+
+def test_reply_cc_keeps_only_approved_and_drops_self_and_sender(monkeypatch):
+    a = make(monkeypatch)
+    others = ["bot@gmail.com", "bob@corp.com", "carol@corp.com", "stranger@evil.com", "alice@corp.com",
+              "bob@corp.com"]
+    assert a._reply_cc("alice@corp.com", others) == ["bob@corp.com", "carol@corp.com"]
+
+
+def test_new_reply_sets_cc_header_only_when_there_is_one(monkeypatch):
+    a = make(monkeypatch)
+    a._thread_context["alice@corp.com"] = {"subject": "Vacation rentals", "message_id": "<m1@corp.com>",
+                                         "cc": ["bob@corp.com", "carol@corp.com"]}
+    msg, _, subject = a._new_reply("alice@corp.com", "done")
+    assert msg["Cc"] == "bob@corp.com, carol@corp.com" and msg["To"] == "alice@corp.com"
+    assert subject == "Re: Vacation rentals" and msg["In-Reply-To"] == "<m1@corp.com>"
+    assert a._new_reply("someone@corp.com", "cron digest")[0]["Cc"] is None
+
+
+def test_cc_only_recipient_still_cannot_instruct(monkeypatch):
+    a = make(monkeypatch)
+    a._require_authenticated_sender = False
+    monkeypatch.setattr(EmailAdapter, "_allow_all_senders", staticmethod(lambda: False))
+    assert not a._sender_accepted("carol@corp.com", {})
+    assert a._sender_accepted("bob@corp.com", {})
