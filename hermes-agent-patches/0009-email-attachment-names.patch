@@ -0,0 +1,21 @@
+"""Attachment names (hermes-deploy patch 0009): drop beardrive's out_<id>_ cache prefix, quote the name."""
+from email.mime.multipart import MIMEMultipart
+
+from plugins.platforms.email.adapter import _attach_file
+
+
+def attached_name(tmp_path, name):
+    p = tmp_path / name
+    p.write_bytes(b"x")
+    msg = MIMEMultipart()
+    _attach_file(msg, p, name)
+    return msg.get_payload()[0].get_filename()
+
+
+def test_drive_cache_prefix_is_dropped(tmp_path):
+    assert attached_name(tmp_path, "out_e02bd77e_Keyword_normalized.xlsx") == "Keyword_normalized.xlsx"
+
+
+def test_other_names_are_kept_and_quoted(tmp_path):
+    assert attached_name(tmp_path, "rental companies (2).xlsx") == "rental companies (2).xlsx"
+    assert attached_name(tmp_path, "out_report.pdf") == "out_report.pdf"
