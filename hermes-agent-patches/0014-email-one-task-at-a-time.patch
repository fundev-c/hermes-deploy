+"""One heavy job at a time (hermes-deploy patch 0014): an email's processing waits for a slot instead of
+running alongside another task; nothing is rejected, and a cancelled wait never leaks a slot."""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+import plugins.platforms.email.adapter as mod
+from plugins.platforms.email.adapter import EmailAdapter
+
+
+@pytest.fixture(autouse=True)
+def fresh_slots(monkeypatch):
+    monkeypatch.setattr(mod, "_get_secret", lambda name, default="": default)
+    monkeypatch.setattr(EmailAdapter, "_task_slots", None)
+    monkeypatch.setattr(EmailAdapter, "_slot_holders", set())
+
+
+def event(sender):
+    return SimpleNamespace(source=SimpleNamespace(chat_id=sender))
+
+
+def test_second_email_waits_for_the_first():
+    a, order = object.__new__(EmailAdapter), []
+
+    async def task(ev, name, work):
+        await a.on_processing_start(ev)
+        order.append(f"{name} start")
+        await asyncio.sleep(work)
+        order.append(f"{name} end")
+        await a.on_processing_complete(ev, "success")
+
+    async def go():
+        await asyncio.gather(task(event("carol@corp.com"), "A", 0.05), task(event("dave@corp.com"), "B", 0.01))
+    asyncio.run(go())
+    assert order == ["A start", "A end", "B start", "B end"]
+
+
+def test_cancelled_wait_does_not_leak_the_slot():
+    a = object.__new__(EmailAdapter)
+
+    async def go():
+        first = event("carol@corp.com")
+        await a.on_processing_start(first)
+        waiting = event("dave@corp.com")
+        t = asyncio.create_task(a.on_processing_start(waiting))
+        await asyncio.sleep(0.01)
+        t.cancel()
+        await asyncio.gather(t, return_exceptions=True)
+        await a.on_processing_complete(waiting, "cancelled")  # the gateway reports the cancel too
+        await a.on_processing_complete(first, "success")
+        third = event("erin@corp.com")
+        await asyncio.wait_for(a.on_processing_start(third), 0.5)  # a free slot, not a deadlock
+        await a.on_processing_complete(third, "success")
+    asyncio.run(go())
+    assert EmailAdapter._slot_holders == set()
