@@ -0,0 +1,67 @@
+"""Email activity log (hermes-deploy patch 0013): what came in, what went out (with attachment
+names and sizes), still-working notes and inbox outages land in logs/email.jsonl."""
+import asyncio
+import json
+from email.mime.multipart import MIMEMultipart
+from email.mime.text import MIMEText
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+import plugins.platforms.email.adapter as mod
+from plugins.platforms.email.adapter import EmailAdapter, _attach_file
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(mod, "_get_secret", lambda name, default="": default)
+    return tmp_path
+
+
+def rows(home):
+    p = home / "logs" / "email.jsonl"
+    return [json.loads(line) for line in p.read_text().splitlines()] if p.exists() else []
+
+
+def make() -> EmailAdapter:
+    a = EmailAdapter.__new__(EmailAdapter)
+    a.__init__(MagicMock(extra={"address": "bot@gmail.com"}))
+    return a
+
+
+def test_sent_email_records_recipients_and_attachments(home, tmp_path):
+    a = make()
+    f = tmp_path / "out_e02bd77e_Keyword_normalized.xlsx"
+    f.write_bytes(b"x" * 1234)
+    msg = MIMEMultipart()
+    msg["To"], msg["Cc"], msg["Subject"] = "carol@corp.com", "dave@corp.com", "Re: Upper case"
+    msg.attach(MIMEText("Done, file attached.", "plain", "utf-8"))
+    _attach_file(msg, f, f.name)
+    a._record_sent(msg)
+    (r,) = rows(home)
+    assert r["kind"] == "out" and r["to"] == "carol@corp.com" and r["cc"] == ["dave@corp.com"]
+    assert r["files"] == [{"name": "Keyword_normalized.xlsx", "bytes": 1234}]
+
+
+def test_still_working_note_is_its_own_kind(home):
+    a = make()
+    msg = MIMEMultipart()
+    msg["To"], msg["Subject"] = "carol@corp.com", "Re: Upper case"
+    msg.attach(MIMEText(mod._ACK_TEXT, "plain", "utf-8"))
+    a._record_sent(msg)
+    assert rows(home)[0]["kind"] == "ack"
+
+
+def test_inbound_mail_and_outages_are_recorded(home, monkeypatch):
+    a = make()
+    a._sender_accepted = lambda *args: True
+    a.handle_message = AsyncMock()
+    monkeypatch.setattr(mod, "_esecret_int", lambda name, default: 0 if name == "EMAIL_ACK_AFTER_MINUTES" else default)
+    asyncio.run(a._dispatch_message({"sender_addr": "carol@corp.com", "sender_name": "Carol", "subject": "Upper case",
+                                     "body": "hi", "attachments": [], "message_id": "<1@x>", "in_reply_to": ""}))
+    monkeypatch.setattr(EmailAdapter, "_inbox_down_since", {"bot@gmail.com": mod.time.time() - 600})
+    monkeypatch.setattr(EmailAdapter, "_inbox_alerted", set())
+    a._inbox_ok()
+    kinds = [(r["kind"], r.get("sender"), r.get("minutes")) for r in rows(home)]
+    assert kinds[0] == ("in", "carol@corp.com", None) and kinds[1][0] == "outage" and kinds[1][2] >= 9.9
