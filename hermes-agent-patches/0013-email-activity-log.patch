+    def _record_sent(self, msg: MIMEMultipart) -> None:
+        """Patch 0013: say what actually went out (Gmail's Sent folder was the only record of attachments)."""
+        files = [(p.get_filename(), len(p.get_payload(decode=True) or b"")) for p in msg.walk() if p.get_filename()]
