--- a/tests/gateway/test_email_outbox_batching.py
+++ b/tests/gateway/test_email_outbox_batching.py
@@ -0,0 +1,91 @@
+"""Email outbox staging (hermes-deploy patch 0007): with platforms.email.batch_seconds > 0, the
+gateway's text messages to one recipient are mailed as one email per window, attachments carry
+whatever is staged, nothing is lost on disconnect, and batch_seconds 0 keeps one-email-per-send."""
+import asyncio
+from unittest.mock import MagicMock
+
+from plugins.platforms.email.adapter import EmailAdapter
+
+
+def make(batch: float) -> EmailAdapter:
+    a = object.__new__(EmailAdapter)
+    a._address, a._password, a._thread_context = "bot@example.com", "secret", {}
+    a._batch_seconds, a._outbox, a._outbox_tasks = batch, {}, {}
+    a._running, a._poll_task = False, None
+    a._send_email = MagicMock(return_value="<id@x>")
+    a._send_email_with_attachment = MagicMock(return_value="<id@x>")
+    return a
+
+
+def test_messages_in_one_window_become_one_email():
+    a = make(0.05)
+
+    async def go():
+        for t in ("Working on it…", "Read the sheet: 25,544 rows.", "Done. Task T-abc123"):
+            assert (await a.send("u@example.com", t, reply_to="<orig@x>")).success
+        a._send_email.assert_not_called()
+        await asyncio.sleep(0.15)
+    asyncio.run(go())
+    a._send_email.assert_called_once()
+    to, body, rid = a._send_email.call_args.args
+    assert to == "u@example.com" and rid == "<orig@x>"
+    assert body == "Working on it…\n\nRead the sheet: 25,544 rows.\n\nDone. Task T-abc123"
+
+
+def test_recipients_are_batched_separately_and_duplicates_collapse():
+    a = make(0.05)
+
+    async def go():
+        await a.send("a@example.com", "same")
+        await a.send("a@example.com", "same")
+        await a.send("b@example.com", "other")
+        await asyncio.sleep(0.15)
+    asyncio.run(go())
+    sent = {c.args[0]: c.args[1] for c in a._send_email.call_args_list}
+    assert sent == {"a@example.com": "same", "b@example.com": "other"}
+
+
+def test_attachment_carries_staged_text_in_the_same_email():
+    a = make(30)
+
+    async def go():
+        await a.send("u@example.com", "Here is the corrected sheet.", reply_to="<orig@x>")
+        r = await a.send_document("u@example.com", "/tmp/x.xlsx", caption="attach")
+        await asyncio.sleep(0)
+        return r
+    assert asyncio.run(go()).success
+    a._send_email.assert_not_called()
+    to, body, path, name, rid = a._send_email_with_attachment.call_args.args
+    assert body == "Here is the corrected sheet.\n\nattach" and rid == "<orig@x>"
+    assert not a._outbox and not a._outbox_tasks
+
+
+def test_disconnect_flushes_instead_of_dropping():
+    a = make(30)
+
+    async def go():
+        await a.send("u@example.com", "final answer")
+        await a.disconnect()
+    asyncio.run(go())
+    assert a._send_email.call_args.args[1] == "final answer"
+
+
+def test_failed_window_is_retried_once():
+    a = make(0.05)
+    a._send_email = MagicMock(side_effect=[OSError("smtp down"), "<id@x>"])
+
+    async def go():
+        await a.send("u@example.com", "hello")
+        await asyncio.sleep(0.25)
+    asyncio.run(go())
+    assert a._send_email.call_count == 2 and a._send_email.call_args.args[1] == "hello"
+
+
+def test_batching_off_sends_immediately():
+    a = make(0)
+
+    async def go():
+        await a.send("u@example.com", "one")
+        await a.send("u@example.com", "two")
+    asyncio.run(go())
+    assert [c.args[1] for c in a._send_email.call_args_list] == ["one", "two"]
