+++ b/tests/gateway/test_email_threads.py
@@ -0,0 +1,62 @@
+"""One session per email thread (hermes-deploy patch 0010): the thread is the subject without Re:/Fwd:
+prefixes; replies, Cc and the outbox follow the mail being answered, not the sender's latest mail."""
+import asyncio
+from unittest.mock import AsyncMock, MagicMock
+
+import plugins.platforms.email.adapter as mod
+from gateway.session import build_session_key
+from plugins.platforms.email.adapter import EmailAdapter, _thread_key
+
+
+def test_replies_and_forwards_share_the_thread():
+    k = _thread_key("Upper case", "<a@x>")
+    assert k == _thread_key("RE: RE: Upper case", "<b@x>") == _thread_key("Re:  upper   CASE ", "<c@x>")
+    assert k == _thread_key("FW: [EXTERNAL] RE: Upper case", "<d@x>") == _thread_key("AW[2]: Upper case", "<e@x>")
+    assert k != _thread_key("Rental scraping", "<a@x>")
+    assert _thread_key("", "<a@x>") != _thread_key("", "<b@x>")
+
+
+def make(monkeypatch, batch: float = 0) -> EmailAdapter:
+    monkeypatch.setattr(mod, "_get_secret", lambda name, default="": default)
+    a = EmailAdapter.__new__(EmailAdapter)
+    a.__init__(MagicMock(extra={"address": "bot@gmail.com", "batch_seconds": batch}))
+    a._sender_accepted = lambda *args: True
+    a.handle_message = AsyncMock()
+    a._send_email = MagicMock(return_value="<id@x>")
+    return a
+
+
+def inbound(a, subject, mid):
+    asyncio.run(a._dispatch_message({"sender_addr": "carol@corp.com", "sender_name": "Carol", "subject": subject,
+                                     "body": "hi", "attachments": [], "message_id": mid, "in_reply_to": ""}))
+    return a.handle_message.call_args.args[0]
+
+
+def test_each_thread_gets_its_own_session(monkeypatch):
+    a = make(monkeypatch)
+    first, reply, other = (inbound(a, s, m) for s, m in (("Upper case", "<1@x>"), ("RE: Upper case", "<2@x>"),
+                                                         ("Rental scraping", "<3@x>")))
+    keys = [build_session_key(e.source) for e in (first, reply, other)]
+    assert keys[0] == keys[1] != keys[2]
+    assert all(k.startswith("agent:main:email:dm:carol@corp.com:t") for k in keys)
+
+
+def test_reply_uses_the_answered_mail_not_the_latest(monkeypatch):
+    a = make(monkeypatch)
+    inbound(a, "Upper case", "<1@x>")
+    inbound(a, "Rental scraping", "<3@x>")  # arrives while the first is still being worked on
+    msg, _, subject = a._new_reply("carol@corp.com", "done", "<1@x>")
+    assert subject == "Re: Upper case" and msg["In-Reply-To"] == "<1@x>"
+
+
+def test_outbox_never_merges_two_threads(monkeypatch):
+    a = make(monkeypatch, batch=0.05)
+    one, two = inbound(a, "Upper case", "<1@x>"), inbound(a, "Rental scraping", "<3@x>")
+
+    async def go():
+        await a.send("carol@corp.com", "keywords done", reply_to="<1@x>", metadata={"thread_id": one.source.thread_id})
+        await a.send("carol@corp.com", "rentals done", reply_to="<3@x>", metadata={"thread_id": two.source.thread_id})
+        await asyncio.sleep(0.15)
+    asyncio.run(go())
+    sent = sorted((c.args[1], c.args[2]) for c in a._send_email.call_args_list)
+    assert sent == [("keywords done", "<1@x>"), ("rentals done", "<3@x>")]
