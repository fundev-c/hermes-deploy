+++ b/tests/gateway/test_email_attachments_land_in_owner_profile.py
@@ -0,0 +1,42 @@
+"""hermes-deploy: a multiplexed gateway polls email outside any profile scope, so a named
+profile's attachments were cached under the DEFAULT profile, out of reach of that profile's
+drive jail and sandbox mounts. The fetch must run with HERMES_HOME bound to the owner."""
+import os
+from unittest.mock import patch
+
+from gateway.config import PlatformConfig
+
+
+def _adapter():
+    env = {"EMAIL_ADDRESS": "a@x", "EMAIL_PASSWORD": "p", "EMAIL_IMAP_HOST": "i", "EMAIL_SMTP_HOST": "s"}
+    with patch.dict(os.environ, env):
+        from plugins.platforms.email.adapter import EmailAdapter
+        return EmailAdapter(PlatformConfig(enabled=True))
+
+
+def test_fetch_caches_under_the_owning_profile(tmp_path, monkeypatch):
+    from hermes_constants import get_hermes_home
+    team = tmp_path / "profiles" / "team"
+    team.mkdir(parents=True)
+    a = _adapter()
+    a.set_owner_profile("team")
+    seen = {}
+
+    def fake_fetch():
+        from gateway.platforms.base import get_document_cache_dir
+        seen["home"], seen["cache"] = get_hermes_home(), get_document_cache_dir()
+        return []
+    monkeypatch.setattr(a, "_fetch_new_messages", fake_fetch)
+    with patch("hermes_cli.profiles.get_profile_dir", lambda name: team):
+        a._fetch_in_owner_home()
+    assert seen["home"] == team
+    assert team in seen["cache"].parents
+    assert get_hermes_home() != team  # override is reset afterwards
+
+
+def test_default_profile_adapter_is_unchanged(monkeypatch):
+    from hermes_constants import get_hermes_home
+    a = _adapter()
+    before = get_hermes_home()
+    monkeypatch.setattr(a, "_fetch_new_messages", lambda: [get_hermes_home()])
+    assert a._fetch_in_owner_home() == [before]
